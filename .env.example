# =====================================================================
# Tomoro Coffee — Auto Register .env (template)
# Copy ke .env lalu sesuaikan kalau perlu.
# =====================================================================

# --- Default akun ---
DEFAULT_PIN=000000
DEFAULT_REF_CODE=R568MT
DEFAULT_AREA_CODE=62

# --- API target ---
BASE_URL=https://api-service.tomoro-coffee.id

# --- TigerTally wToken signer (frida bridge) ---
# SEPT 2026 PATCH: Tomoro API staat achter Aliyun WAF. ELK request moet header
# `wToken` hebben, gesigneerd door native libtiger_tally.so (vmpSign(bodyBytes)).
# Python kan die niet berekenen → lokal daemon draait op rooted phone via
# frida-java-bridge (zie tigertally_bridge/ + start_bridge.bat).
USE_SIGNER=1
SIGNER_URL=http://127.0.0.1:8642
SIGNER_TIMEOUT=15
SIGNER_RETRIES=3

# RELAY MODUS (aanbevolen zodra WAF weer 200 geeft): stuur ELK request VIA de
# app zelf (phone OkHttp + interceptor vmpSign) — geen handmatige wToken.
# Omzeilt de WAF client-pin volledig. Vereist: app op phone actief + bridge.
# Nadeel: 1 request per relay; de app moet verkeer maken binnen ~40s.
# USE_RELAY=1

# --- Header statis (default dari HAR; jangan diubah kecuali tahu apa yang dilakukan) ---
COUNTRY_CODE=id
APP_LANGUAGE=en
APP_CHANNEL=google play
REVISION=3.4.3
USER_AGENT=okhttp/5.1.0
TIMEZONE=Asia/Bangkok

# wToken dari HAR — server Tomoro tidak memvalidasi (terverifikasi). Kosongkan saja.
WTOKEN_PASSTHRU=
# Header `s` yang muncul di sendMessage. Pass-through dari HAR.
SENDMSG_S_HEADER=9464daa10b535370a24a2b978028e640

# --- Generator persona ---
MIN_AGE=20
MAX_AGE=40
BIRTHDAY_OFFSET_MIN=41
BIRTHDAY_OFFSET_MAX=100

# --- Anti-bot delay (ms) antar request dalam satu pendaftaran ---
JITTER_MIN_MS=800
JITTER_MAX_MS=2500

# --- Geo bounding box untuk longitude/latitude device (Indonesia) ---
GEO_LON_MIN=95.0
GEO_LON_MAX=141.0
GEO_LAT_MIN=-10.5
GEO_LAT_MAX=5.5

# =========================================================
# OTP / SMS rental provider
# =========================================================
# Pilihan: hero-sms, manual.
OTP_PROVIDER=hero-sms

# --- HeroSMS ---
# Login → Profile → Get API key.
HERO_SMS_API_KEY=YOUR_KEY_HERE
HERO_SMS_BASE_URL=https://hero-sms.com/stubs/handler_api.php
# Service code Tomoro Coffee di country=6 (Indonesia). Cek list: action=getServicesList&country=6
HERO_SMS_SERVICE=ang
HERO_SMS_COUNTRY=6
HERO_SMS_OPERATOR=any
HERO_SMS_MAX_PRICE=0.02
HERO_SMS_OTP_TIMEOUT=135
HERO_SMS_POLL_SEC=5

# =========================================================
# Proxy (round-robin dari proxy.txt)
# =========================================================
USE_PROXY=1
PROXY_FILE=proxy.txt
PROXY_MAX_ATTEMPTS=3

# Proxy precheck — sebelum sewa nomor, validasi proxy ke URL ini.
# Tujuannya supaya saldo OTP tidak terbakar gara-gara proxy mati.
PROXY_PRECHECK_URL=https://api-service.tomoro-coffee.id/portal/app/member/getPhoneArea
PROXY_PRECHECK_TIMEOUT=12
# 0 = scan SELURUH pool sampai ketemu yang hidup (rekomendasi untuk pool 100+).
# >0 = batasi jumlah percobaan precheck per akun.
PROXY_PRECHECK_MAX_TRIES=0

# =========================================================
# Bulk mode
# =========================================================
DEFAULT_BULK_COUNT=1
MAX_BULK_COUNT=50
BULK_MAX_ATTEMPTS_MULTIPLIER=3
BULK_INTER_ACCOUNT_DELAY_MIN=3
BULK_INTER_ACCOUNT_DELAY_MAX=8

# =========================================================
# Threading
# =========================================================
# Jumlah worker paralel. Tiap worker punya proxy + persona sendiri.
# Manual mode otomatis dipaksa ke 1 (butuh input stdin).
WORKER_THREADS=3
MAX_WORKER_THREADS=10
